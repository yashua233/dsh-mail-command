{
  "name": "dsh-mail-command",
  "version": "1.3.17",
  "description": "用邮件指挥 DeepSeek Harness：回复通知邮件即可让任务继续或停止，正文可以写具体要求。必须搭配 dsh-qq-mail-notify 使用——口令随它的通知邮件发出，单独安装本插件无效。",

  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mail",
    "imap",
    "command",
    "automation"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "companions": {
      "dsh-qq-mail-notify": "发送侧，必须：一次性口令随它的通知邮件发出，没有它本插件收不到可回复的邮件"
    },
    "compatibility": {
      "dsh": "0.2.1-rc.5"
    }
  },
  "dshTarget": "0.2.1-rc.5",
  "license": "MIT",
  "author": {
    "name": "yashua233"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashua233/dsh-mail-command.git"
  },
  "bugs": {
    "url": "https://github.com/yashua233/dsh-mail-command/issues"
  },
  "homepage": "https://github.com/yashua233/dsh-mail-command#readme"
}
